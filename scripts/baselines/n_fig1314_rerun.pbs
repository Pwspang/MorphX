#!/bin/bash
# nscc2b, one node: Fig 13/14 rerun after the runner stall fix (runner-stall-fix branch),
# one table and one input/output length per job: baseline, stream and MorphX at every rate
# of that row set (H200 rates = paper x MORPHX_PD_RPS_SCALE from env-h100.sh, i.e. x3).
# Default (2026-10-28): sm90 mycutlass fp16 (microbench/build-model-sm90 in this checkout) +
# pass-built FA3 prefill / FA2 decode; MORPHX_LEGACY_SM80_FA2=1 (qsub -v) gives the earlier
# Sm80 mycutlass fp16 + pass-built FA2 setup. MorphX with per-grid profiling and each row's
# default split (paper's A100 hints scaled to 132 SMs: 76 -> 93, 88 -> 108). 60 s per point.
#   cd ~/scratch/morphx/trackFI && qsub -v TABLE=Figure13,LEN=in-2048-out-256 <this file>
# SMS_EXTRA adds MorphX env, e.g. SMS_EXTRA=MORPHX_SHORT_BYPASS_TOTAL=1 so the non-persistent
# FA3 prefill is managed instead of short-bypassed (docs/HANDOFF.md, "FA3 through the pass").
# Every step under a timeout; log tee'd live to $OUT/job-<id>.log.
#PBS -N mx1314-fix
#PBS -P 12004493
#PBS -q normal
#PBS -l select=1:ncpus=16:ngpus=1:mem=120gb
#PBS -l walltime=00:40:00
#PBS -j oe
set -uo pipefail
: "${TABLE:?set TABLE=Figure13|Figure14}" "${LEN:?set LEN, e.g. in-2048-out-256}"
R=${PBS_O_WORKDIR:-$PWD}
OUT=${OUT:-$R/logs/20261028-fig1314-fix/$TABLE-$LEN-${PBS_JOBID%%.*}}
mkdir -p "$OUT"
exec > >(tee -a "$OUT/job-${PBS_JOBID:-$$}.log") 2>&1
echo "== start $(hostname) $(date +%T) out=$OUT"
type module >/dev/null 2>&1 || source /etc/profile.d/modules.sh
module load cuda/13.0
[[ -n "${CUDA_HOME:-}" ]] || { echo "module load cuda/13.0 failed"; exit 1; }
cd "$R"
source "${MORPHX_VENV:-$HOME/scratch/morphx/envs/sglang-stock}/bin/activate"
source scripts/ae/env-nscc2b.sh
export MORPHX_PYTHON="$(command -v python)"
if [[ "${CUDA_VISIBLE_DEVICES:-}" == GPU-* ]]; then export CUDA_VISIBLE_DEVICES=0; fi
if [[ "${MORPHX_LEGACY_SM80_FA2:-0}" == 1 ]]; then
  LIB=${SM80:-$HOME/scratch/morphx/MorphX/microbench/build-model}  # read-only, main checkout
else
  LIB=${SM90:-$R/microbench/build-model-sm90}
fi
export MYCUTLASS_LIB_DIR=$LIB MORPHX_FLASHINFER_PASS=1
RTB=$R/runtime/build-llm
HOOK="NEUTRINO_HOOK_DRIVER=$RTB/libcuda.so LD_PRELOAD=$RTB/libcuda.so:$RTB/libpreload.so"
VARIANTS=${VARIANTS:-"baseline stream smsched"}
grep -q "_wait_stream" scripts/sglang/runner.py || { echo "runner.py lacks the stall fix"; exit 1; }
[[ -f $LIB/libmycutlass.so && -f $RTB/libcuda.so ]] || { echo "missing $LIB/libmycutlass.so or runtime"; exit 1; }
echo "== host=$(hostname) job=${PBS_JOBID:-} table=$TABLE len=$LEN variants=$VARIANTS pd_scale=$MORPHX_PD_RPS_SCALE lib=$LIB legacy=${MORPHX_LEGACY_SM80_FA2:-0}"

vargs=()
for v in $VARIANTS; do vargs+=(--only-variant "$v"); done
timeout -k 10 2300 python scripts/ae/run_pd_colocate_part2.py --python "$MORPHX_PYTHON" --duration "${DURATION:-60}" \
  --only-table "$TABLE" --only-config "$TABLE:$LEN-rps-*" "${vargs[@]}" --no-update-latest-link --run-timeout 300 \
  --smsched-env "$HOOK SMSCHED_LLM_TRICK_MODE=0 SMSCHED_LLM_TRACE_LIMIT=0 SMSCHED_PROFILE_LOG=1 MORPHX_PROFILE_PER_GRID=1${SMS_EXTRA:+ $SMS_EXTRA}" \
  --output-dir "$OUT/run" > "$OUT/run.log" 2>&1
echo "== run rc=$? $(date +%T)"
cat "$OUT"/run/tables/*.tsv 2>/dev/null | cut -f1-14
for f in "$OUT"/run/logs/pd-online/*/*/*.err; do
  [[ -f $f ]] || continue
  s=$(grep -h "MorphX-profile\] summary" "$f" | sed 's/.*\] //')
  [[ -n $s ]] && echo "   $(basename "$(dirname "$f")") $s"
  grep -hE "Traceback|Error" "$f" | head -2
done
for f in "$OUT"/run/logs/pd-online/*/*/*.log; do
  m=$(grep -oE "requests served: [0-9]+, total time: [0-9.]+s, generated: [0-9]+" "$f" | tail -1)
  [[ -n $m ]] && echo "   $(basename "$(dirname "$f")")/$(basename "$f" .log): $m"
done
echo "== done $(date +%T)"
