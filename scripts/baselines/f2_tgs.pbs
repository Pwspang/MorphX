#!/bin/bash
# Track F2: TGS hijack on CUDA 13 (hpcc H200). Probes torch/cuBLAS under the
# hijack (new vs legacy cuGetProcAddress handling), then a Fig 11(a) TGS point.
#   cd <repo> && qsub scripts/baselines/f2_tgs.pbs
#   qsub -v PARTS="probe" ...   (parts: probe bisect calls identity bindings fig11), FIG11_DURATION=60
# Needs TGS/hijack/{high,low}-priority-lib (TGS/hijack/build.sh) and
# microbench/build-model/libmycutlass.so in this checkout.
#PBS -N morphx-f2-tgs
#PBS -P fs_ccds_dmitrii.ustiugov
#PBS -q gpu_free
#PBS -l select=1:ncpus=12:ngpus=1:mem=200gb
#PBS -l walltime=00:50:00
#PBS -j oe
module purge
module load cuda/13.0
# sglang jit_kernel (tvm-ffi/nvcc at run time) fails to parse with gcc 12.3; gcc 13 works
source /opt/rh/gcc-toolset-13/enable
source "${SGLANG_ENV:-$HOME/morphx/envs/sglang-stock}/bin/activate"
cd "$PBS_O_WORKDIR"
source scripts/ae/env-h100.sh
export MORPHX_PYTHON="$(command -v python)"
if [[ "${CUDA_VISIBLE_DEVICES:-}" == GPU-* ]]; then export CUDA_VISIBLE_DEVICES=0; fi
PARTS=${PARTS:-"probe fig11"}
OUT=${OUT:-$HOME/morphx/runs/f2-$PBS_JOBID}
mkdir -p "$OUT"
echo "== host=$(hostname) job=$PBS_JOBID out=$OUT driver=$(head -1 /proc/driver/nvidia/version)"

probe='import torch
a = torch.randn(512, 512, device="cuda")
print("fp32 matmul", float((a @ a).sum()))
h = a.half()
print("fp16 matmul", float((h @ h).float().sum()))
print("linear", float(torch.nn.functional.linear(h, h).float().sum()))
torch.cuda.synchronize()
print("PROBE_OK")'
libs() { ls TGS/hijack/$1-priority-lib/{libcontroller.so,libcuda.so,libcuda.so.1} | paste -sd:; }
run_probe() {  # label env...
  local label=$1; shift
  echo "-- $label"
  env "$@" timeout 180 python -c "$probe" > "$OUT/probe-$label.log" 2>&1
  echo "   rc=$?"
  grep -vE "^\[TGS-GPA\]|^\[mod\]" "$OUT/probe-$label.log" | grep -E "PROBE_OK|matmul|linear|Error" | head -6
  echo "   lookups: $(grep -c '^\[TGS-GPA\]' "$OUT/probe-$label.log"), hooked: $(grep '^\[TGS-GPA\]' "$OUT/probe-$label.log" | grep -c -E 'hooked=|legacy')"
  grep '^\[TGS-GPA\]' "$OUT/probe-$label.log" | grep -E "hooked=|legacy" | sed -E 's/ ver=[0-9]+//' | sort | uniq -c | head -12
}
if [[ " $PARTS " == *" probe "* ]]; then
  run_probe none
  run_probe high-new TGS_TRACE_GPA=1 LD_PRELOAD="$(libs high)"
  run_probe high-legacy TGS_TRACE_GPA=1 TGS_GPA_LEGACY=1 LD_PRELOAD="$(libs high)"
  run_probe low-new TGS_TRACE_GPA=1 LD_PRELOAD="$(libs low)"
  echo "-- high-legacy: last lookups before the failure"
  grep '^\[TGS-GPA\]' "$OUT/probe-high-legacy.log" | tail -8
fi

if [[ " $PARTS " == *" bisect "* ]]; then
  launch=cuGetProcAddress,cuLaunchKernel,cuLaunchKernelEx,cuLaunchCooperativeKernel
  mod=cuGetProcAddress,cuModuleLoadData,cuLibraryLoadData,cuModuleLoadDataEx,cuModuleLoadFatBinary,cuModuleGetFunction,cuKernelGetFunction,cuLibraryGetKernel,cuLibraryGetModule
  cudaonly=$(ls TGS/hijack/high-priority-lib/{libcuda.so,libcuda.so.1} | paste -sd:)
  run_probe high-none TGS_GPA_HOOKS=none LD_PRELOAD="$(libs high)"
  run_probe high-gpaonly TGS_GPA_HOOKS=cuGetProcAddress LD_PRELOAD="$(libs high)"
  run_probe high-launch TGS_GPA_HOOKS=$launch LD_PRELOAD="$(libs high)"
  run_probe high-mod TGS_GPA_HOOKS=$mod LD_PRELOAD="$(libs high)"
  run_probe cudaonly-none TGS_GPA_HOOKS=none LD_PRELOAD="$cudaonly"
fi

if [[ " $PARTS " == *" calls "* ]]; then
  cudaonly=$(ls TGS/hijack/high-priority-lib/{libcuda.so,libcuda.so.1} | paste -sd:)
  run_probe calls-none TGS_GPA_HOOKS=none TGS_TRACE_CALLS=1 LD_PRELOAD="$cudaonly"
  echo "-- forwarded calls (count, name, result)"
  grep '^\[TGS-CALL\]' "$OUT/probe-calls-none.log" | sort | uniq -c | sort -rn | head -30
  echo "-- last forwarded calls"
  grep -n '^\[TGS-CALL\]\|cublas\|Error' "$OUT/probe-calls-none.log" | tail -15
fi

if [[ " $PARTS " == *" identity "* ]]; then
  # Does cuBLAS care which file provides libcuda.so.1?
  drv=$(sed -n 's/.*Kernel Module  *\([0-9.]*\).*/\1/p' /proc/driver/nvidia/version)
  V=/tmp/f2-ver-$PBS_JOBID; mkdir -p $V
  cp TGS/hijack/high-priority-lib/libcuda.so.1 $V/libcuda.so.$drv
  ln -sf libcuda.so.$drv $V/libcuda.so.1
  run_probe versioned-name TGS_GPA_HOOKS=none LD_PRELOAD=$V/libcuda.so.1
  R=$HOME/MorphX/runtime/build
  run_probe morphx-hook LD_PRELOAD=$R/libcuda.so:$R/libpreload.so
  run_probe morphx-cudahook LD_PRELOAD=$R/libcuda_hook.so
  run_probe real-preload LD_PRELOAD=/usr/lib64/libcuda.so.1
  ls -l $V
fi

if [[ " $PARTS " == *" bindings "* ]]; then
  # Which objects bind symbols to the hijack, and which libcuda/libnvidia objects load?
  cudaonly=$(ls TGS/hijack/high-priority-lib/{libcuda.so,libcuda.so.1} | paste -sd:)
  rm -f /tmp/f2-ld-$PBS_JOBID.*
  LD_DEBUG=bindings,libs LD_DEBUG_OUTPUT=/tmp/f2-ld-$PBS_JOBID TGS_GPA_HOOKS=none LD_PRELOAD="$cudaonly" \
    timeout 180 python -c "$probe" > "$OUT/probe-bindings.log" 2>&1; echo "   rc=$?"
  cat /tmp/f2-ld-$PBS_JOBID.* > "$OUT/ld-debug.txt"
  echo "-- objects binding to the hijack (count, from-object)"
  grep "to $PWD/TGS/hijack" "$OUT/ld-debug.txt" | sed -E 's/.*binding file ([^ ]+).*/\1/' | sort | uniq -c | sort -rn | head -20
  echo "-- symbols bound to the hijack from non-python objects"
  grep "to $PWD/TGS/hijack" "$OUT/ld-debug.txt" | grep -v "python" | sed -E "s/.*binding file ([^ ]+) .*symbol \`([^']+)'.*/\1 \2/" | sort | uniq -c | sort -rn | head -30
  echo "-- libcuda / nvidia objects loaded"
  grep -E "calling init: .*(cuda|nvidia)" "$OUT/ld-debug.txt" | sed -E 's/^ *[0-9]+: *//' | sort -u | head -20
fi

if [[ " $PARTS " == *" fig11 "* ]]; then
  echo "== Fig 11(a) llm-1-mm-1: tgs + stream"
  timeout 1800 python scripts/ae/run_colocate_part1.py --only-experiment llm-1-mm-1 \
    --only-scheduler tgs --only-scheduler stream --model llama-3-8b --duration "${FIG11_DURATION:-60}" \
    --output-dir "$OUT/fig11" --run-timeout 900 2>&1 | grep -E "DONE|FAILED|WARNING|ERROR|preflight"
  for f in "$OUT"/fig11/logs/colocate/llm-mm/llm-1-mm-1/*.log; do
    echo "-- $f"; sed -n '/=== Results ===/,$p' "$f" | head -20
  done
  for f in "$OUT"/fig11/logs/colocate/llm-mm/llm-1-mm-1/*.err; do
    [[ -s "$f" ]] || continue
    echo "-- $f"; grep -iE "error|fatal|abort|traceback|rate watcher" "$f" | grep -v "^\[mod\]" | head -10
  done
  ls -l "$MORPHX_TGS_SOCKET_DIR"
fi
echo "== done"
